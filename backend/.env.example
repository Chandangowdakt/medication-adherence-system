# Copy to .env and adjust values
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/adherence_db
JWT_SECRET=your_secret_key
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=*

# Per-dose tracking: DoseLog drives analytics (real dose counts), POST /api/logs → daily rollup DoseLog.
# false = MedicationLog only (slot-weighted adherence), POST /api/dose-logs returns 403.
USE_DOSE_LEVEL=false

# Background: auto-missed sweep (interval). Set false on secondary instances or when debugging.
ENABLE_CRON=true
