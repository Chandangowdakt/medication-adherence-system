# Copy to .env and adjust values
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/adherence_db
JWT_SECRET=your_secret_key
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=*

# Per-dose tracking: DoseLog drives analytics (real dose counts), cron/push, POST /api/logs → daily rollup DoseLog.
# false = MedicationLog only (slot-weighted adherence), POST /api/dose-logs returns 403.
USE_DOSE_LEVEL=false

# Background: auto-missed sweep (interval) + FCM reminder/missed crons. Set false on secondary instances or when debugging.
ENABLE_CRON=true

# Firebase Cloud Messaging (server push). Use one of:
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
#
# Optional: verbose FCM (logs each send, cron tick; good for debugging only)
# FCM_DEBUG=true
# FCM_LOG_TICKS=true
# FCM_LOG_CRON_TICK=true

# Test push to your own first token: GET /api/test-notification (requires JWT) — allow only in dev:
# ALLOW_FCM_TEST=true

